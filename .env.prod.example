# ============================================================
#  Cloud Health — Variables d'environnement PRODUCTION
# ============================================================
#  Copier ce fichier en `.env` à la racine sur l'EC2 :
#     cp .env.prod.example .env
#  Puis remplacer les valeurs CHANGE_ME par des secrets robustes.
#
#  /!\ Ne JAMAIS commiter le `.env` dans Git.
# ============================================================

# ----------- MySQL (ms-patients) -----------
MYSQL_ROOT_PASSWORD=CHANGE_ME_MySQL_Root_Strong_Password
MYSQL_DATABASE=cloud_health_patients
MYSQL_USER=patients_user
MYSQL_PASSWORD=CHANGE_ME_MySQL_App_Password

# ----------- PostgreSQL (ms-rendezvous) -----------
POSTGRES_DB=cloud_health_rendezvous
POSTGRES_USER=rendezvous_user
POSTGRES_PASSWORD=CHANGE_ME_Postgres_App_Password

# ----------- MongoDB (ms-dossiers) -----------
MONGO_USER=dossiers_user
MONGO_PASSWORD=CHANGE_ME_Mongo_App_Password
MONGO_DB=cloud_health_dossiers

# ----------- Symfony (ms-patients) -----------
# Génère 32+ caractères aléatoires :
#   openssl rand -hex 32
SYMFONY_APP_SECRET=CHANGE_ME_random_32_chars_hex_string_here_replace_me_now
