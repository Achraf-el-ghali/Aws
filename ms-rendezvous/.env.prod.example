# ============================================================
# ms-rendezvous — Variables d'environnement PRODUCTION (AWS ECS)
# ============================================================
# Ces variables sont à injecter dans la Task Definition ECS Fargate.
# .NET Core utilise __ (double underscore) pour les sections imbriquées.

# Mode production (utilise appsettings.Production.json)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:80

# Connexion RDS PostgreSQL (endpoint fourni par AWS RDS)
# Format: Host=ENDPOINT;Port=5432;Database=DB;Username=USER;Password=PASS
ConnectionStrings__DefaultConnection=Host=cloud-health-rendezvous.xxxxxxxx.eu-west-3.rds.amazonaws.com;Port=5432;Database=cloud_health_rendezvous;Username=rendezvous_user;Password=CHANGE_ME

# Kafka — DNS Service Discovery ECS (Cloud Map)
Kafka__BootstrapServers=kafka.cloud-health.local:29092
