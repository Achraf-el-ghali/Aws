# ============================================================
# ms-dossiers — Variables d'environnement PRODUCTION (AWS ECS)
# ============================================================
# Ces variables sont à injecter dans la Task Definition ECS Fargate.

# Active le profil "prod" (charge application-prod.yml)
SPRING_PROFILES_ACTIVE=prod

# Connexion Amazon DocumentDB (compatible MongoDB)
# IMPORTANT : tls=true + tlsCAFile pointe vers le bundle CA téléchargé dans le Dockerfile
# IMPORTANT : retryWrites=false (DocumentDB ne supporte pas les retryable writes)
SPRING_DATA_MONGODB_URI=mongodb://dossiers_user:CHANGE_ME@cloud-health-dossiers.cluster-xxxxxxxx.eu-west-3.docdb.amazonaws.com:27017/cloud_health_dossiers?tls=true&tlsCAFile=/app/global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# Kafka — DNS Service Discovery ECS (Cloud Map)
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka.cloud-health.local:29092

# Optionnel : niveau de log
LOGGING_LEVEL_ROOT=INFO
