# ============================================================
# ms-patients — Variables d'environnement PRODUCTION (AWS ECS)
# ============================================================
# Ces variables sont à injecter dans la Task Definition ECS Fargate.
# Elles surchargent automatiquement les valeurs du .env local.
# NE PAS commiter ce fichier avec de vrais secrets.

# Mode production (désactive le profiler, optimise le cache)
APP_ENV=prod
APP_DEBUG=0

# Secret Symfony (générer une chaîne aléatoire de 32+ caractères)
# Utiliser AWS Secrets Manager en production réelle
APP_SECRET=CHANGE_ME_GENERATE_RANDOM_32_CHARS

# Connexion RDS MySQL (endpoint fourni par AWS RDS)
# Format: mysql://USER:PASS@RDS_ENDPOINT:3306/DB_NAME?serverVersion=8.0
DATABASE_URL="mysql://patients_user:CHANGE_ME@cloud-health-patients.xxxxxxxx.eu-west-3.rds.amazonaws.com:3306/cloud_health_patients?serverVersion=8.0"

# Kafka — DNS Service Discovery ECS (Cloud Map)
# Le container Kafka est enregistré sous "kafka.cloud-health.local"
KAFKA_BROKERS=kafka.cloud-health.local:29092

# CORS — accepte toutes les origines (l'API n'est exposée que via l'ALB derrière CloudFront)
# La config nelmio_cors.yaml force déjà '*' pour les routes /api/, donc cette valeur est peu utilisée
CORS_ALLOW_ORIGIN=*

# Optionnel : niveau de log (info en prod)
# APP_LOG_LEVEL=info
