# ============================================================
#  ms-patients — Symfony PRODUCTION
# ============================================================
#  Les valeurs réelles sont surchargées par Docker Compose
#  via le bloc `environment:` du service ms-patients.
#  Ce fichier sert uniquement à fixer le mode prod par défaut.
# ============================================================

APP_ENV=prod
APP_DEBUG=0

# Surchargés par Docker Compose
# DATABASE_URL="mysql://USER:PASS@db-patients:3306/DB?serverVersion=8.0"
# KAFKA_BROKERS=kafka:29092
# APP_SECRET=injecté via Compose
# CORS_ALLOW_ORIGIN=*
